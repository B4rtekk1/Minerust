@group(0) @binding(0) var hist: texture_2d<f32>; @group(0) @binding(1) var normal_tex:texture_2d<f32>; @group(0) @binding(2) var material:texture_2d<f32>; @group(0) @binding(3) var out_tex:texture_storage_2d<rgba16float,write>;
@compute @workgroup_size(8,8) fn main(@builtin(global_invocation_id) id:vec3<u32>){let s=textureDimensions(hist);if(any(id.xy>=s)){return;}let p=vec2<i32>(id.xy);let n=textureLoad(normal_tex,p,0).xyz;let m=textureLoad(material,p,0);if(m.y<.5){textureStore(out_tex,p,vec4(0.));return;}var sum=textureLoad(hist,p,0);var w=1.;for(var y=-1;y<=1;y++){for(var x=-1;x<=1;x++){if(x==0&&y==0){continue;}let q=clamp(p+vec2(x,y),vec2(0),vec2<i32>(s)-1);let qm=textureLoad(material,q,0);let nw=max(dot(n,textureLoad(normal_tex,q,0).xyz),0.);let ww=nw*nw*select(0.,1.,qm.y>.5)*(1.-abs(qm.x-m.x)*3.);sum+=textureLoad(hist,q,0)*max(ww,0.);w+=max(ww,0.);}}textureStore(out_tex,p,sum/w);}
